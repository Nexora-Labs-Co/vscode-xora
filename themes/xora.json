  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#4a4e69",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords & Operators",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control"
      ],
      "settings": {
        "foreground": "#6366F1",
        "fontStyle": ""
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "support.variable",
        "variable.parameter",
        "meta.parameter"
      ],
      "settings": {
        "foreground": "#c9cdd4"
      }
    },
    {
      "name": "Variable Property",
      "scope": [
        "variable.other.object.property",
        "variable.other.property",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#c9cdd4"
      }
    },
    {
      "name": "Constants",
      "scope": [
        "constant.language",
        "constant.numeric",
        "constant.character.numeric"
      ],
      "settings": {
        "foreground": "#fbbf24"
      }
    },
    {
      "name": "Constant & Built-in",
      "scope": [
        "constant.language",
        "support.constant",
        "constant.character"
      ],
      "settings": {
        "foreground": "#f472b6"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#34d399"
      }
    },
    {
      "name": "String Escape",
      "scope": [
        "constant.character.escape",
        "string source",
        "string source.rust"
      ],
      "settings": {
        "foreground": "#6366F1"
      }
    },
    {
      "name": "Types",
      "scope": [
        "entity.name.type",
        "support.type",
        "keyword.type"
      ],
      "settings": {
        "foreground": "#fbbf24"
      }
    },
    {
      "name": "Classes",
      "scope": [
        "entity.name.class",
        "support.class"
      ],
      "settings": {
        "foreground": "#fbbf24"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#6366F1"
      }
    },
    {
      "name": "Function Call",
      "scope": [
        "meta.function-call",
        "meta.function-call entity.name.function"
      ],
      "settings": {
        "foreground": "#6366F1"
      }
    },
    {
      "name": "Methods",
      "scope": [
        "keyword.other.definition",
        "storage.type.function"
      ],
      "settings": {
        "foreground": "#6366F1"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#f87171"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#fbbf24"
      }
    },
    {
      "name": "Attributes Value",
      "scope": [
        "string.unquoted",
        "string.template",
        "meta.string-contents"
      ],
      "settings": {
        "foreground": "#34d399"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#fbbf24"
      }
    },
    {
      "name": "Boolean",
      "scope": [
        "constant.language.boolean",
        "constant.language.json"
      ],
      "settings": {
        "foreground": "#f472b6"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "punctuation.terminator",
        "punctuation.separator",
        "punctuation.definition"
      ],
      "settings": {
        "foreground": "#6b7084"
      }
    },
    {
      "name": "Delimiter",
      "scope": [
        "delimiter",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#6b7084"
      }
    },
    {
      "name": "Preprocessor & Macros",
      "scope": [
        "meta.preprocessor",
        "keyword.other.include",
        "entity.name.function.preprocessor"
      ],
      "settings": {
        "foreground": "#6366F1cc"
      }
    },
    {
      "name": "Type Casting",
      "scope": [
        "keyword.other.type",
