    {
      "name": "Decorators",
      "scope": [
        "meta.decorator",
        "punctuation.decorator"
      ],
      "settings": {
        "foreground": "#fbbf24"
      }
    },
    {
      "name": "Regex",
      "scope": [
        "string.regexp",
        "keyword.operator.regexp"
      ],
      "settings": {
        "foreground": "#22d3ee"
      }
    },
    {
      "name": "JSON Key",
