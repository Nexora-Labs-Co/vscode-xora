  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#6B6B74",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords & Operators",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control"
      ],
      "settings": {
        "foreground": "#8b5cf6",
        "fontStyle": ""
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "support.variable",
        "variable.parameter",
        "meta.parameter"
      ],
      "settings": {
        "foreground": "#16161A"
      }
    },
    {
      "name": "Variable Property",
      "scope": [
        "variable.other.object.property",
        "variable.other.property",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#16161A"
      }
    },
    {
      "name": "Constants",
      "scope": [
        "constant.language",
        "constant.numeric",
        "constant.character.numeric"
      ],
      "settings": {
        "foreground": "#f59e0b"
      }
    },
    {
      "name": "Constant & Built-in",
      "scope": [
        "constant.language",
        "support.constant",
        "constant.character"
      ],
      "settings": {
        "foreground": "#ec4899"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#10b981"
      }
    },
    {
      "name": "String Escape",
      "scope": [
        "constant.character.escape",
        "string source",
        "string source.rust"
      ],
      "settings": {
        "foreground": "#8b5cf6"
      }
    },
    {
      "name": "Types",
      "scope": [
        "entity.name.type",
        "support.type",
        "keyword.type"
      ],
      "settings": {
        "foreground": "#f59e0b"
      }
    },
    {
      "name": "Classes",
      "scope": [
        "entity.name.class",
        "support.class"
      ],
      "settings": {
        "foreground": "#f59e0b"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#8b5cf6"
      }
    },
    {
      "name": "Function Call",
      "scope": [
        "meta.function-call",
        "meta.function-call entity.name.function"
      ],
      "settings": {
        "foreground": "#8b5cf6"
      }
    },
    {
      "name": "Methods",
      "scope": [
        "keyword.other.definition",
        "storage.type.function"
      ],
      "settings": {
        "foreground": "#8b5cf6"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#ef4444"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#f59e0b"
      }
    },
    {
      "name": "Attributes Value",
      "scope": [
        "string.unquoted",
        "string.template",
        "meta.string-contents"
      ],
      "settings": {
        "foreground": "#10b981"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#f59e0b"
      }
    },
    {
      "name": "Boolean",
      "scope": [
        "constant.language.boolean",
        "constant.language.json"
      ],
      "settings": {
        "foreground": "#ec4899"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "punctuation.terminator",
        "punctuation.separator",
        "punctuation.definition"
      ],
      "settings": {
        "foreground": "#42424A"
      }
    },
    {
      "name": "Delimiter",
      "scope": [
        "delimiter",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#42424A"
      }
    },
    {
      "name": "Preprocessor & Macros",
      "scope": [
        "meta.preprocessor",
        "keyword.other.include",
        "entity.name.function.preprocessor"
      ],
      "settings": {
        "foreground": "#8b5cf6cc"
      }
    },
    {
      "name": "Type Casting",
      "scope": [
        "keyword.other.type",
        "storage.type.annotation"
      ],
      "settings": {
        "foreground": "#f59e0b"
      }
    },
    {
      "name": "Decorators",
      "scope": [
        "meta.decorator",
        "punctuation.decorator"
      ],
      "settings": {
        "foreground": "#f59e0b"
      }
    },
    {
      "name": "Regex",
      "scope": [
        "string.regexp",
        "keyword.operator.regexp"
      ],
      "settings": {
        "foreground": "#06b6d4"
      }
    },
    {
      "name": "JSON Key",
      "scope": [
        "support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#16161A"
      }
    },
    {
      "name": "JSON String",
      "scope": [
        "string.quoted.json"
      ],
      "settings": {
        "foreground": "#10b981"
      }
    },
    {
      "name": "YAML Key",
      "scope": [
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#ef4444"
      }
    },
    {
      "name": "YAML String",
      "scope": [
        "string.unquoted.plain.out.yaml"
      ],
      "settings": {
        "foreground": "#10b981"
      }
    },
    {
      "name": "GitGutter Added",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#10b981"
      }
    },
    {
      "name": "GitGutter Deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#ef4444"
      }
    },
    {
      "name": "GitGutter Changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#8b5cf6"
      }
    },
    {
      "name": "Block Level Colors",
      "scope": [
        "support.type.vendored.property-name"
      ],
      "settings": {
        "foreground": "#42424A"
